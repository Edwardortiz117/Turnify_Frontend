# Copiar a .env para docker compose (opcional)
#   cp .env.docker.example .env

# Puerto publicado en el host (contenedor escucha en 80)
FRONTEND_PORT=8080

# Upstream del backend visto DESDE el contenedor
# Nginx: esquema + host (sin http:// en BACKEND_UPSTREAM)
BACKEND_SCHEME=https
BACKEND_UPSTREAM=turnify-backend.ingsoftwarefesc.com
# Local (backend en el host):
# BACKEND_SCHEME=http
# BACKEND_UPSTREAM=host.docker.internal:3000
# CapRover (misma red interna):
# BACKEND_SCHEME=http
# BACKEND_UPSTREAM=srv-captain--turnify-backend:3000
# Backend como contenedor en turnify-net:
# BACKEND_SCHEME=http
# BACKEND_UPSTREAM=backend:3000

# Dejar vacío para same-origin + proxy Nginx.
VITE_API_BASE_URL=
