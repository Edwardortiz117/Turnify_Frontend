# Copiar a .env para docker compose (opcional)
#   cp .env.docker.example .env

# Puerto del contenedor de desarrollo (Vite + HMR)
FRONTEND_PORT=5173

# Puerto del contenedor de producción (profile prod)
FRONTEND_PROD_PORT=8080

# Upstream del backend visto DESDE el contenedor (con http:// o https://)
# Backend desplegado:
VITE_PROXY_TARGET=https://turnify-backend.ingsoftwarefesc.com
# Backend en el host (Windows/Mac Docker Desktop):
# VITE_PROXY_TARGET=http://host.docker.internal:3000
# Backend como contenedor en turnify-net:
# VITE_PROXY_TARGET=http://backend:3000

# Nginx prod (sin esquema http/https):
BACKEND_UPSTREAM=turnify-backend.ingsoftwarefesc.com
# BACKEND_UPSTREAM=host.docker.internal:3000

# Dejar vacío para same-origin + proxy Vite/Nginx.
VITE_API_BASE_URL=
