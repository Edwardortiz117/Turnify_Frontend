# Copiar a .env para docker compose (opcional)
#   cp .env.docker.example .env

FRONTEND_PORT=8080

# Upstream del backend (host:puerto, sin http://)
# Backend en el host:
BACKEND_UPSTREAM=host.docker.internal:3000
# Backend como contenedor en turnify-net:
# BACKEND_UPSTREAM=backend:3000

# Dejar vacío para same-origin + proxy Nginx (recomendado).
# Solo definir si el navegador debe llamar al backend DIRECTAMENTE
# (entonces el backend debe permitir CORS desde http://localhost:8080):
# VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=
